    "@hono/zod-validator": "^0.8.0",
    "@huntara/auth": "workspace:*",
    "@huntara/core": "workspace:*",
    "@huntara/logger": "workspace:*",
    "@huntara/schema": "workspace:*",
    "@huntara/sdk": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.9",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "hono": "^4.12.27",
    "jsonwebtoken": "^9.0.3",
